# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored; this file is not.
# NEVER put a real token in this file.
# ---------------------------------------------------------------------------

# --- Databricks ------------------------------------------------------------
# Workspace URL, e.g. https://dbc-1234abcd-5678.cloud.databricks.com
DATABRICKS_HOST=
# Personal access token: User Settings -> Developer -> Access tokens
DATABRICKS_TOKEN=

# --- MLflow ----------------------------------------------------------------
# "databricks" to log into the workspace, empty for a local ./mlruns store
MLFLOW_TRACKING_URI=
# "databricks-uc" to register models into Unity Catalog
MLFLOW_REGISTRY_URI=
MLFLOW_EXPERIMENT_NAME=/Shared/forgeml

# --- Hugging Face ----------------------------------------------------------
# Only needed for gated models or to push artifacts to the Hub
HF_TOKEN=
HF_HOME=

# --- Serving ---------------------------------------------------------------
# models:/forgeml_champion@champion | runs:/<run_id>/model | /path/to/checkpoint
FORGEML_MODEL_URI=
FORGEML_BASE_MODEL=
FORGEML_STUB=
FORGEML_LOAD_4BIT=
FORGEML_LAZY_LOAD=
PORT=8000

# --- Misc ------------------------------------------------------------------
FORGEML_LOG_LEVEL=INFO
# Any config key can be overridden: FORGEML__training__epochs=3
